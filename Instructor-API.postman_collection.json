{
  "info": {
    "name": "Quiz Tournament - Instructor API",
    "description": "Instructor role flow: login, create tournament, add questions (manual + OpenTDB), view own tournaments, update, view player scores, delete. Instructor has no frontend UI, so this is the required demo path for that role. Tournament id 2 (\"Science Sprint\") was already created live on the Render backend before these requests were finalised, so its id is hardcoded below.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "instructor1", "type": "string" },
      { "key": "password", "value": "Instructor@123", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "1. Login check (whoami)",
      "request": {
        "method": "GET",
        "url": "https://quiz-tournament-backend-rapt.onrender.com/api/users/me"
      },
      "response": []
    },
    {
      "name": "2. Create tournament (already run - id 2)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "https://quiz-tournament-backend-rapt.onrender.com/api/instructors/tournaments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Science Sprint\",\n  \"category\": \"Science\",\n  \"difficulty\": \"MEDIUM\",\n  \"startDate\": \"2026-09-09T00:00:00\",\n  \"endDate\": \"2026-09-25T23:59:00\",\n  \"minPassingScore\": 50\n}"
        }
      },
      "response": []
    },
    {
      "name": "3. Add a manual question",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "https://quiz-tournament-backend-rapt.onrender.com/api/instructors/tournaments/2/questions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"questionText\": \"What is the chemical symbol for gold?\",\n  \"type\": \"MULTIPLE\",\n  \"correctAnswer\": \"Au\",\n  \"choices\": [\"Au\", \"Ag\", \"Fe\", \"Gd\"]\n}"
        }
      },
      "response": []
    },
    {
      "name": "4. Fetch 10 questions from OpenTDB",
      "request": {
        "method": "POST",
        "url": "https://quiz-tournament-backend-rapt.onrender.com/api/instructors/tournaments/2/questions/opentdb?difficulty=medium"
      },
      "response": []
    },
    {
      "name": "5. View my tournaments",
      "request": {
        "method": "GET",
        "url": "https://quiz-tournament-backend-rapt.onrender.com/api/instructors/tournaments/my"
      },
      "response": []
    },
    {
      "name": "6. Update tournament",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "https://quiz-tournament-backend-rapt.onrender.com/api/instructors/tournaments/2",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Science Sprint (Updated)\",\n  \"startDate\": \"2026-09-09T00:00:00\",\n  \"endDate\": \"2026-09-26T23:59:00\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "7. View player scores for tournament",
      "request": {
        "method": "GET",
        "url": "https://quiz-tournament-backend-rapt.onrender.com/api/tournaments/2/scores"
      },
      "response": []
    },
    {
      "name": "8. Delete own tournament",
      "request": {
        "method": "DELETE",
        "url": "https://quiz-tournament-backend-rapt.onrender.com/api/instructors/tournaments/2"
      },
      "response": []
    }
  ]
}
